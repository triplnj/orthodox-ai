generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  name                       String?
  passwordHash               String?
  plan                       Plan                     @default(FREE)
  stripeCustomerId           String?
  subscriptionStatus         String?
  subscriptionId             String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  emailVerified              DateTime?
  dailyTime                  String?
  experienceLevel            String?
  onboardingCompleted        Boolean                  @default(false)
  spiritualGoal              String?
  lemonSqueezyCustomerId     String?
  lemonSqueezyOrderId        String?
  lemonSqueezySubscriptionId String?
  lemonSqueezyVariantId      String?
  billingDeletionRequestedAt DateTime?
  billingRecoveryLog         Json?
  billingAccessUntil         DateTime?
  billingGraceUntil          DateTime?
  legacyReconciliationDeadlineAt DateTime? @db.Timestamp(3)
  billingSubscriptions       BillingSubscription[]
  billingCheckoutAttempts    BillingCheckoutAttempt[]
  messages                   ChatMessage[]
  conversations              Conversation[]
  chatTurns                  ChatTurn[]
  aiReservations             AiReservation[]
  emailVerificationTokens    EmailVerificationToken[]
  journalEntries             JournalEntry[]
  passwordResetTokens        PasswordResetToken[]
  sessions                   Session[]
  usageLogs                  UsageLog[]

  @@map("users")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  turnId String?
  conversation Conversation? @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)
  turn ChatTurn? @relation(fields: [turnId, conversationId, userId], references: [id, conversationId, userId], onDelete: Cascade)
  sources ChatMessageSource[]

  @@index([userId])
  @@unique([turnId, role])
  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}

model Conversation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextKey String @default("general")
  activeTurnId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turns ChatTurn[]
  messages ChatMessage[]
  @@unique([id, userId])
  @@index([userId, updatedAt, id])
}

model ChatTurn {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation Conversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)
  requestId String
  fingerprint String
  question String
  status String @default("PENDING")
  executionToken String
  dispatchedAt DateTime?
  finishedAt DateTime?
  failureCode String?
  evidenceSnapshot Json?
  responseSnapshot Json?
  budgetSnapshot Json?
  createdAt DateTime @default(now())
  messages ChatMessage[]
  @@unique([userId, requestId])
  @@unique([id, conversationId, userId])
  @@index([conversationId, createdAt, id])
  @@index([status, createdAt])
}

model ChatMessageSource {
  id String @id @default(cuid())
  messageId String
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceOrder Int
  provider String
  authorName String?
  workTitle String?
  reference String?
  originalLanguage String?
  sourceUrl String
  scanUrl String?
  verificationStatus String
  includedInContext Boolean
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([messageId, sourceOrder])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([userId, feature, createdAt])
  @@map("usage_logs")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  aiSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("journal_entries")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  category    String?
  status      BlogPostStatus @default(DRAFT)
  authorEmail String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model PatristicQuote {
  id                 String                 @id @default(cuid())
  fingerprint        String                 @unique
  authorName         String
  authorNameOriginal String?
  workTitle          String
  workTitleOriginal  String?
  originalLanguage   String
  originalText       String
  section            String?
  chapter            String?
  paragraph          String?
  pgReference        String?
  scReference        String?
  cpgReference       String?
  translationSr      String?
  translationEn      String?
  topics             String[]
  verification       PatristicVerification  @default(CANDIDATE)
  confidence         Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  embedding          Unsupported("vector")?
  sources            PatristicQuoteSource[]
}

model PatristicQuoteSource {
  id          String         @id @default(cuid())
  quoteId     String
  url         String
  sourceName  String?
  sourceType  String?
  exactMatch  Boolean        @default(false)
  page        String?
  column      String?
  retrievedAt DateTime       @default(now())
  quote       PatristicQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, url])
}

model PatristicDiscoveryJob {
  id         String                      @id @default(cuid())
  query      String
  language   String
  status     PatristicDiscoveryJobStatus @default(PENDING)
  attempts   Int                         @default(0)
  error      String?
  createdAt  DateTime                    @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  claimToken String?
  dispatchedAt DateTime?

  @@index([status, createdAt])
}

model AiReservation {
  id         String   @id @default(cuid())
  subject    String
  feature    String
  status     String   @default("RUNNING")
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  finishedAt DateTime?
  userId String?
  requestKey String? @db.VarChar(128)
  requestHash String? @db.Char(64)
  responseSnapshot Json?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subject, feature, requestKey], map: "AiReservation_subject_feature_requestKey_key")
  @@index([userId], map: "AiReservation_userId_idx")
  @@index([status, finishedAt], map: "AiReservation_status_finishedAt_idx")

  @@index([subject, createdAt])
  @@index([subject, status, expiresAt])
}

model BillingSubscription {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider String
  providerSubscriptionId String
  providerCustomerId String?
  providerProductId String?
  status String @default("unverified_legacy")
  legacySnapshotStatus String?
  trialEndsAt DateTime?
  currentPeriodEndsAt DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  providerUpdatedAt DateTime?
  lastVerifiedAt DateTime?
  paidVerified Boolean @default(false)
  retainedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider, providerSubscriptionId], map: "BillingSubscription_provider_subscription_key")
  @@index([userId])
}

model BillingWebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String
  eventType String
  providerSubscriptionId String?
  payloadDigest String
  occurredAt DateTime?
  status String @default("RECEIVED")
  receivedAt DateTime @default(now())
  processedAt DateTime?
  errorCode String?
  @@unique([provider, eventId], map: "BillingWebhookEvent_provider_event_key")
}

model BillingCheckoutAttempt {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider String
  status String @default("CREATING")
  providerCheckoutId String?
  checkoutUrl String?
  expiresAt DateTime?
  recoveryLog Json?
  retainedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model AuthRateLimitBucket {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model PatristicSourceDomain {
  hostname String @id
  enabled Boolean @default(true)
  redirectHosts String[]
  verifiedAt DateTime
  verifiedBy String
  verificationNote String
  updatedAt DateTime @updatedAt
}

model PatristicSourceDomainAudit {
  id String @id @default(cuid())
  hostname String
  actorId String
  action String
  reason String
  addresses String[]
  redirectHosts String[]
  createdAt DateTime @default(now())
  @@index([hostname, createdAt])
}

enum Plan {
  FREE
  PRO
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum PatristicVerification {
  CANDIDATE
  TEXT_VERIFIED
  MULTI_SOURCE_VERIFIED
  REJECTED
}

enum PatristicDiscoveryJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

 
// Patristic Library is a separate, opt-in bibliographic catalogue.
// These tables are never read by chat retrieval or billing.
model LibraryAuthor {
  id           String @id @default(cuid())
  slug         String @unique
  name         String
  originalName String?
  aliases      String[] @default([])
  period       String?
  language     String?
  status       String @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attributions LibraryAttribution[]
  @@index([name])
}

model LibraryWork {
  id             String @id @default(cuid())
  slug           String @unique
  title          String
  originalTitle  String?
  aliases        String[] @default([])
  language       String?
  genre          String?
  externalIds    Json?
  survivalStatus String @default("UNKNOWN")
  status         String @default("DRAFT")
  parentWorkId   String?
  parentWork     LibraryWork? @relation("LibraryWorkParts", fields: [parentWorkId], references: [id], onDelete: SetNull)
  parts          LibraryWork[] @relation("LibraryWorkParts")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  attributions   LibraryAttribution[]
  editions       LibraryEdition[]
  evidence       LibraryEvidence[]
  reviews        LibraryReview[]
  @@index([title])
  @@index([status])
  @@index([parentWorkId])
}

model LibraryAttribution {
  id           String @id @default(cuid())
  authorId     String
  workId       String
  role         String @default("AUTHOR")
  authenticity String @default("UNDETERMINED")
  note         String?
  author       LibraryAuthor @relation(fields: [authorId], references: [id], onDelete: Restrict)
  work         LibraryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  evidence     LibraryEvidence[]
  @@unique([authorId, workId, role])
  @@index([workId])
}

model LibraryEdition {
  id            String @id @default(cuid())
  workId        String
  title         String
  editor        String?
  publisher     String?
  year          Int?
  language      String?
  url           String?
  citation      String?
  textStatus    String @default("METADATA_ONLY")
  rightsStatus  String @default("UNKNOWN")
  expectedUnits Int?
  availableUnits Int?
  work          LibraryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  evidence      LibraryEvidence[]
  @@index([workId])
}

model LibraryEvidence {
  id            String @id @default(cuid())
  workId        String
  attributionId String?
  editionId     String?
  sourceTitle   String
  sourceUrl     String?
  reference     String?
  note          String?
  reviewed      Boolean @default(false)
  work          LibraryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  attribution   LibraryAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  edition       LibraryEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  @@index([workId, reviewed])
}

model LibraryReview {
  id         String @id @default(cuid())
  workId     String
  actorId    String
  action     String
  note       String
  createdAt  DateTime @default(now())
  work       LibraryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@index([workId, createdAt])
}
