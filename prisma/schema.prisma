generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  name                       String?
  passwordHash               String?
  plan                       Plan                     @default(FREE)
  stripeCustomerId           String?
  subscriptionStatus         String?
  subscriptionId             String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  emailVerified              DateTime?
  dailyTime                  String?
  experienceLevel            String?
  onboardingCompleted        Boolean                  @default(false)
  spiritualGoal              String?
  lemonSqueezyCustomerId     String?
  lemonSqueezyOrderId        String?
  lemonSqueezySubscriptionId String?
  lemonSqueezyVariantId      String?
  messages                   ChatMessage[]
  emailVerificationTokens    EmailVerificationToken[]
  journalEntries             JournalEntry[]
  passwordResetTokens        PasswordResetToken[]
  sessions                   Session[]
  usageLogs                  UsageLog[]

  @@map("users")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_messages")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@map("usage_logs")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String
  aiSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("journal_entries")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  category    String?
  status      BlogPostStatus @default(DRAFT)
  authorEmail String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model PatristicQuote {
  id                 String                 @id @default(cuid())
  fingerprint        String                 @unique
  authorName         String
  authorNameOriginal String?
  workTitle          String
  workTitleOriginal  String?
  originalLanguage   String
  originalText       String
  section            String?
  chapter            String?
  paragraph          String?
  pgReference        String?
  scReference        String?
  cpgReference       String?
  translationSr      String?
  translationEn      String?
  topics             String[]
  verification       PatristicVerification  @default(CANDIDATE)
  confidence         Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  embedding          Unsupported("vector")?
  sources            PatristicQuoteSource[]
}

model PatristicQuoteSource {
  id          String         @id @default(cuid())
  quoteId     String
  url         String
  sourceName  String?
  sourceType  String?
  exactMatch  Boolean        @default(false)
  page        String?
  column      String?
  retrievedAt DateTime       @default(now())
  quote       PatristicQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, url])
}

enum Plan {
  FREE
  PRO
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum PatristicVerification {
  CANDIDATE
  TEXT_VERIFIED
  MULTI_SOURCE_VERIFIED
  REJECTED
}
